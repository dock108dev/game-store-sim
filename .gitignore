.DS_Store
artifacts/
game/.godot/
game/build/
game/builds/
*.tmp
*.blend1
*.blend2
*.blend@
assets/blender/review-renders/tmp/
.homebrew-cache/

# Keep generated source archives and raw movie audio local.
/encounter/evidence/**/*.tar.gz
/encounter/evidence/**/frame.wav

# Disposable source-tool bytecode; retained evidence copies remain trackable.
/encounter/scripts/__pycache__/
/assets/blender/scripts/__pycache__/
/encounter/.godot/

# Large generated evidence stays local; keep source, logs, reports and still screenshots.
/encounter/evidence/**/*.app/
/encounter/evidence/**/*.zip
/encounter/evidence/**/*.mp4
/encounter/evidence/**/pace/*.png
/encounter/evidence/**/pace/*.jpg
/encounter/evidence/**/pace/*.jpeg
/encounter/evidence/**/frames/**/*.png
/encounter/evidence/**/frames/**/*.jpg
/encounter/evidence/**/frames/**/*.jpeg
