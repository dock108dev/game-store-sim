theme_override_font_sizes/font_size = 22
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="CenterContainer/PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Review the offer."
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1

[node name="OfferAdjustRow" type="HBoxContainer" parent="CenterContainer/PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
