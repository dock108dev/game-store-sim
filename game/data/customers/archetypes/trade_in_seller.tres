[ext_resource type="Script" path="res://scripts/customers/customer_archetype.gd" id="1_customer_archetype"]

[resource]
script = ExtResource("1_customer_archetype")
archetype_id = "trade_in_seller"
display_name = "Trade-In Seller"
role = "trade_in"
preferred_categories = Array[String](["used_game"])
price_sensitivity = 1.15
patience_seconds = 8.0
visual_cue = "carried game, trade tag"
