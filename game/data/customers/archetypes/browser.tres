[ext_resource type="Script" path="res://scripts/customers/customer_archetype.gd" id="1_customer_archetype"]

[resource]
script = ExtResource("1_customer_archetype")
archetype_id = "browser"
display_name = "Browser"
role = "browse"
preferred_categories = Array[String](["used_game", "accessory"])
price_sensitivity = 0.95
patience_seconds = 9.0
visual_cue = "small basket, scanning shelves"
