[gd_resource type="Resource" script_class="CustomerArchetype" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/customers/customer_archetype.gd" id="1_customer_archetype"]

[resource]
script = ExtResource("1_customer_archetype")
archetype_id = "parent_gift_buyer"
display_name = "Parent Gift Buyer"
role = "buy"
preferred_categories = Array[String](["new_game", "accessory"])
price_sensitivity = 0.9
patience_seconds = 11.0
visual_cue = "gift note, cautious posture"
dialogue_style = "asks for recommendations"
dialogue_flow_ids = Array[String](["help_request", "recommendation_request"])
default_feedback = "I need something gift-safe that will not come back tomorrow."
arrival_line = "They read shelf signs twice and hover near accessories before asking for help."
satisfaction_line = "A clear recommendation and fair price sends them to checkout."
friction_line = "Confusing stock or pushy pricing makes them walk out to think."
